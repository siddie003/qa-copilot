# QA Copilot environment configuration.
# Copy to .env (or run `npm run setup:env`, which generates secrets for you).
# Never commit .env. Empty values are treated as "not set".

# --- Core ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---------------------------------------------
# Created by `npm run db:bootstrap` (see README).
DATABASE_URL=postgres://qa_copilot:CHANGE_ME@localhost:5432/qa_copilot
DATABASE_POOL_MAX=10
# Optional: separate database for integration tests
TEST_DATABASE_URL=

# --- Authentication & encryption ------------------------------------------
# Required. 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Required in production. 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Allow new accounts to be created from the sign-up page (set false in production once your
# accounts exist).
AUTH_ALLOW_SIGNUP=true
# Reverse proxies in front of the web app (IPs or CIDR ranges, comma separated). The client IP for
# per-IP sign-in limits is then the rightmost CLIENT_IP_HEADER entry that is not a listed proxy.
TRUSTED_PROXIES=
# Header carrying the client IP set by your proxy (e.g. x-real-ip). Default: x-forwarded-for.
CLIENT_IP_HEADER=x-forwarded-for
# Per-user API rate limits (scan starts, uploads, reports, references, projects, all requests).
# Failed sign-ins are always limited per account (10 per 15 minutes).
RATE_LIMIT_ENABLED=true

# --- Storage --------------------------------------------------------------
# Screenshots, uploads and reports. Relative paths resolve from the repo root.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# --- Approved-content documents (see LARGE_DOCUMENT_PROCESSING.md) ------------
# One processing run; a PDF stopped by it keeps the pages read (partial) and can continue.
DOCUMENT_EXTRACTION_TIMEOUT_MS=300000
# Heap of the isolated parsing thread.
DOCUMENT_PARSER_MEMORY_MB=512
# Blocks stored per document; beyond it the document is marked partial (never cut silently).
DOCUMENT_MAX_BLOCKS=50000
# Size of indexed sections used for search and AI context (capped at AI_MAX_INPUT_TOKENS / 4).
DOCUMENT_CHUNK_TOKENS=600

# --- AI provider (optional) ----------------------------------------------
# none | gemini | groq | anthropic | openai-compatible. With "none", scanners still produce
# findings and every finding still becomes an issue (scanner wording + rule-catalog fix
# guidance). AI only writes issue text and reads brand guidelines; everything it writes is
# checked against the evidence. Free tiers (gemini, groq): see LLM_PROVIDER_SETUP.md for limits
# and data-use terms. Check the setup with `npm run ai:check` (uses one request).
AI_PROVIDER=none
# Required with a provider. Examples: gemini-3.8-flash (gemini), openai/gpt-oss-120b (groq),
# claude-opus-5-5 (anthropic).
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Client-side pacing per worker process (0 = none). On free tiers set these to your plan's
# limits (shown in Google AI Studio / the Groq console), e.g. groq: 30 and 8000.
AI_REQUESTS_PER_MINUTE=0
AI_TOKENS_PER_MINUTE=0
# Estimated input tokens per request; batches of issues are cut to fit (groq free tier: ~3000).
AI_MAX_INPUT_TOKENS=20000
# Issues per scan sent to AI; the rest keep the scanners' wording.
AI_MAX_ISSUES_PER_SCAN=200
# Retries after HTTP 429/5xx/network errors (jittered backoff, Retry-After honoured up to the
# wait below; longer waits end the request). Exhausted daily quotas are never retried.
AI_MAX_RETRIES=3
AI_MAX_RETRY_WAIT_MS=60000
# json_schema (strict structured output) or json_object (for models without strict schemas).
AI_STRUCTURED_OUTPUT=json_schema
# Optional: low | medium | high | xhigh | max (unset = the model's default). Anthropic: effort;
# gemini/groq/openai-compatible: sent as reasoning_effort (xhigh and max become high).
AI_EFFORT=
# Anthropic: re-run requests declined by a safety classifier on Anthropic's recommended
# fallback model (claude-fable-5-1, claude-opus-5-5, claude-opus-5, claude-sonnet-5-5).
AI_REFUSAL_FALLBACK=true
# OpenAI-style providers only (current Claude models reject it). Empty: openai-compatible uses
# 0; gemini/groq use the provider default (Google recommends Gemini 3's default of 1.0).
AI_TEMPERATURE=
# Per request; thinking models can take minutes for a batch of issues.
AI_TIMEOUT_MS=300000
# Includes thinking tokens on models that think.
AI_MAX_OUTPUT_TOKENS=16000
# AI requests sent in parallel per scan (lower it if you hit rate limits).
AI_CONCURRENCY=3
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# e.g. https://api.openai.com/v1 (default) or a self-hosted server's /v1 URL
OPENAI_BASE_URL=

# --- Figma (optional) -----------------------------------------------------
# Personal access token (scopes file_content:read, optionally file_metadata:read). Without it,
# design values can be entered manually. See FIGMA_INTEGRATION.md.
FIGMA_ACCESS_TOKEN=
# Largest Figma response read; larger files are read page by page.
FIGMA_MAX_RESPONSE_MB=50
# Pages per request when reading page by page (fewer requests = less of Figma's quota).
FIGMA_PAGES_PER_REQUEST=10
FIGMA_TIMEOUT_MS=120000
# Retries after short rate-limit waits, server and network errors; longer Retry-After waits stop
# the read (Partial) so it can be continued later.
FIGMA_MAX_RETRIES=3
FIGMA_MAX_RETRY_WAIT_MS=60000

# --- Scanning ---------------------------------------------------------------
SCAN_MAX_PAGES=25
SCAN_MAX_DEPTH=3
# Pages the accessibility scanner analyzes (0 = every page of the scan). Pages not reached within
# 80% of SCAN_SCANNER_TIMEOUT_MS are reported as "Not analyzed" instead of losing all results.
SCAN_ACCESSIBILITY_MAX_PAGES=0
SCAN_PAGE_TIMEOUT_MS=30000
SCAN_SCANNER_TIMEOUT_MS=600000
SCAN_CONCURRENCY=3
LINK_CHECK_RETRIES=3
SCAN_USER_AGENT=QACopilotBot/0.1 (+website QA scanner)
SCAN_RESPECT_ROBOTS=true
# Private/internal hosts that may be scanned (host:port, comma separated). Everything else
# on loopback, private, link-local or metadata ranges is blocked.
SCAN_ALLOWED_PRIVATE_HOSTS=localhost:4100

# --- Worker -----------------------------------------------------------------
WORKER_HEALTH_PORT=3001
# Interface of the worker health endpoint (0.0.0.0 inside containers so probes reach it).
WORKER_HEALTH_HOST=127.0.0.1
# On SIGTERM/SIGINT running scans may continue this long, then they are stopped and recorded as
# failed ("the worker was shut down"). Keep it below your orchestrator's kill timeout.
WORKER_SHUTDOWN_GRACE_MS=20000
# Scans processed in parallel by one worker process (1–8; each uses its own browser).
WORKER_CONCURRENCY=1

# --- Demo mode ----------------------------------------------------------------
DEMO_MODE_ENABLED=true
DEMO_SITE_PORT=4100


