# Settings for docker-compose.yml. Copy to deploy.env (git-ignored), fill in, then:
#   docker compose --env-file deploy.env up -d --build
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"   # BETTER_AUTH_SECRET, POSTGRES_PASSWORD
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"         # ENCRYPTION_KEY

# Public address users open (behind your TLS reverse proxy).
APP_URL=https://qa.example.com
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Encrypts stored site credentials and Figma tokens. Back it up: losing it makes them unreadable.
ENCRYPTION_KEY=

# Create the first accounts with sign-up enabled, then set this to false.
AUTH_ALLOW_SIGNUP=false
# Address(es) of your reverse proxy as seen by the web container (IPs or CIDR ranges).
TRUSTED_PROXIES=
CLIENT_IP_HEADER=x-forwarded-for

# Web port on the host; bound to 127.0.0.1 so only the local reverse proxy reaches it.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Optional AI provider (none | anthropic | openai-compatible).
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional Figma personal access token.
FIGMA_ACCESS_TOKEN=

# Scanning: internal hosts users may scan (host:port, comma separated). Leave empty unless needed.
SCAN_ALLOWED_PRIVATE_HOSTS=
WORKER_CONCURRENCY=1
